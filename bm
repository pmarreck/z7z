#!/usr/bin/env bash
set -euo pipefail

# z7z Benchmark Suite
# Uses hyperfine to compare z7z against the 7zz reference implementation.
# Results logged to tests/benchmark/benchmark.log for regression tracking.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
Z7Z="$SCRIPT_DIR/zig-out/bin/z7z"
LOG_FILE="$SCRIPT_DIR/tests/benchmark/benchmark.log"
BM_TMPDIR=""

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

cleanup() {
	[ -n "$BM_TMPDIR" ] && rm -rf "$BM_TMPDIR"
}
trap cleanup EXIT

# ============================================================================
# Prerequisites
# ============================================================================

echo -e "${BOLD}z7z Benchmark Suite${RESET}"
echo ""

# Build if needed
if [ ! -f "$Z7Z" ]; then
	echo -e "${YELLOW}Binary not found, building...${RESET}"
	(cd "$SCRIPT_DIR" && nix develop -c zig build -Doptimize=ReleaseFast)
fi

# Check prerequisites
for cmd in hyperfine 7zz jq; do
	if ! command -v "$cmd" &>/dev/null; then
		echo -e "${RED}ERROR: $cmd not found. Run inside nix develop.${RESET}" >&2
		exit 1
	fi
done

# Debug build check
BM_TMPDIR="${TMPDIR:-/tmp}/z7z-bm-$$"
mkdir -p "$BM_TMPDIR"

echo -n "tiny" > "$BM_TMPDIR/tiny.txt"
DEBUG_CHECK=$("$Z7Z" create "$BM_TMPDIR/dbg.7z" "$BM_TMPDIR/tiny.txt" 2>&1 || true)
if echo "$DEBUG_CHECK" | grep -q "DEBUG BUILD"; then
	echo -e "${RED}ERROR: z7z is a debug build! Run: ./build${RESET}" >&2
	exit 1
fi
echo -e "${GREEN}ReleaseFast build confirmed${RESET}"
echo ""

# ============================================================================
# Data Generation (deterministic, RAM-backed)
# ============================================================================

echo -e "${BOLD}Generating test data in \$TMPDIR...${RESET}"

# Repeating prose pattern (Project Gutenberg-style)
generate_text() {
	local size=$1 outfile=$2
	local phrase="Call me Ishmael. Some years ago, never mind how long precisely, having little or no money in my purse, and nothing particular to interest me on shore, I thought I would sail about a little and see the watery part of the world. It is a way I have of driving off the spleen and regulating the circulation. Whenever I find myself growing grim about the mouth; whenever it is a damp, drizzly November in my soul; whenever I find myself involuntarily pausing before coffin warehouses, and bringing up the rear of every funeral I meet; and especially whenever my hypos get such an upper hand of me, that it requires a strong moral principle to prevent me from deliberately stepping into the street, and methodically knocking peoples hats off, then I account it high time to get to sea as soon as I can. "
	local phrase_len=${#phrase}
	local generated=0
	local buf=""
	while [ "$generated" -lt "$size" ]; do
		buf+="$phrase"
		generated=$((generated + phrase_len))
	done
	echo -n "${buf:0:$size}" > "$outfile"
}

# Deterministic pseudo-random bytes via dd + /dev/urandom isn't reproducible,
# so use head on a known-seed source. We generate raw bytes with printf + octal.
generate_binary() {
	local size=$1 outfile=$2
	# Use LC_ALL=C to force single-byte locale, ensuring printf %c is one byte
	LC_ALL=C awk -v size="$size" 'BEGIN {
		seed = 314159265
		for (i = 0; i < size; i++) {
			seed = (seed * 1103515245 + 12345) % 2147483648
			printf "%c", int(seed / 65536) % 256
		}
	}' > "$outfile"
}

TEXT_1M="$BM_TMPDIR/text_1m.txt"
TEXT_4M="$BM_TMPDIR/text_4m.txt"
BIN_1M="$BM_TMPDIR/binary_1m.bin"

generate_text 1187840 "$TEXT_1M"  # 1.16MB (1160KB)
generate_text 4194304 "$TEXT_4M"  # 4MB
generate_binary 1048576 "$BIN_1M" # 1MB

# Verify binary file size (awk %c can produce multi-byte in some locales)
actual_bin_size=$(wc -c < "$BIN_1M" | tr -d ' ')
if [ "$actual_bin_size" -ne 1048576 ]; then
	echo -e "${YELLOW}NOTE: Binary file is ${actual_bin_size} bytes (expected 1048576), truncating${RESET}"
	dd if="$BIN_1M" of="$BM_TMPDIR/binary_1m_trunc.bin" bs=1048576 count=1 2>/dev/null
	mv "$BM_TMPDIR/binary_1m_trunc.bin" "$BIN_1M"
fi

echo -e "  ${CYAN}text_1m.txt${RESET}  $(wc -c < "$TEXT_1M" | tr -d ' ') bytes (1.16MB prose)"
echo -e "  ${CYAN}text_4m.txt${RESET}  $(wc -c < "$TEXT_4M" | tr -d ' ') bytes (4MB prose)"
echo -e "  ${CYAN}binary_1m.bin${RESET} $(wc -c < "$BIN_1M" | tr -d ' ') bytes (1MB pseudo-random)"
echo ""

# ============================================================================
# Logging Helpers
# ============================================================================

mkdir -p "$(dirname "$LOG_FILE")"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Log results from hyperfine JSON and compare against previous runs.
log_results() {
	local file_label="$1" json_file="$2"
	local z7z_archive="$3" ref_st_archive="$4" ref_mt_archive="$5"
	local original_size="$6"

	local num_results
	num_results=$(jq '.results | length' "$json_file")

	for ((i = 0; i < num_results; i++)); do
		local cmd
		cmd=$(jq -r ".results[$i].command" "$json_file")

		# Derive label from command content
		local label
		if echo "$cmd" | grep -q "z7z"; then
			label="z7z (auto)"
		elif echo "$cmd" | grep -q "mmt=1"; then
			label="7zz -mx=5 -mmt=1"
		elif echo "$cmd" | grep -q "mmt=on"; then
			label="7zz -mx=5 -mmt=on"
		else
			label="unknown"
		fi

		local mean stddev
		mean=$(jq -r ".results[$i].mean" "$json_file")
		stddev=$(jq -r ".results[$i].stddev" "$json_file")

		# Find the corresponding archive for size measurement
		local archive=""
		case "$label" in
			*z7z*) archive="$z7z_archive" ;;
			*mmt=1*) archive="$ref_st_archive" ;;
			*mmt=on*) archive="$ref_mt_archive" ;;
		esac

		local compressed_size=0
		if [ -n "$archive" ] && [ -f "$archive" ]; then
			compressed_size=$(wc -c < "$archive" | tr -d ' ')
		fi

		local ratio
		ratio=$(awk "BEGIN { printf \"%.1f\", ($compressed_size / $original_size) * 100 }")

		# Append to log
		echo "$TIMESTAMP | $label | $file_label | $mean | $stddev | $compressed_size | ${ratio}%" >> "$LOG_FILE"

		# Compare against previous run for same label+file (skip if first run)
		local prev_line
		prev_line=$(grep " | ${label} | ${file_label} | " "$LOG_FILE" 2>/dev/null | tail -2 | head -1 || true)
		if [ -n "$prev_line" ]; then
			local prev_mean
			prev_mean=$(echo "$prev_line" | awk -F'|' '{gsub(/ /,"",$4); print $4}')
			if [ -n "$prev_mean" ] && [ "$prev_mean" != "$mean" ]; then
				local pct_change
				pct_change=$(awk "BEGIN { printf \"%.1f\", (($mean - $prev_mean) / $prev_mean) * 100 }")
				local abs_change
				abs_change=$(awk "BEGIN { v = $pct_change; if (v < 0) v = -v; print v }")

				if awk "BEGIN { exit !($abs_change > 10) }"; then
					if awk "BEGIN { exit !($pct_change > 0) }"; then
						echo -e "  ${RED}WARNING: $label/$file_label is +${pct_change}% slower than previous${RESET}"
					else
						echo -e "  ${GREEN}NOTICE: $label/$file_label is ${pct_change}% faster than previous${RESET}"
					fi
				fi
			fi
		fi
	done
}

# ============================================================================
# Benchmark Runner
# ============================================================================

run_benchmark_group() {
	local data_file="$1" file_label="$2"
	local original_size
	original_size=$(wc -c < "$data_file" | tr -d ' ')
	local size_mb
	size_mb=$(awk "BEGIN { printf \"%.2f\", $original_size / 1048576 }")

	echo -e "${BOLD}=== $file_label (${size_mb}MB) ===${RESET}"
	echo ""

	local z7z_out="$BM_TMPDIR/z7z_${file_label}.7z"
	local ref_st_out="$BM_TMPDIR/7zz_st_${file_label}.7z"
	local ref_mt_out="$BM_TMPDIR/7zz_mt_${file_label}.7z"
	local result_json="$BM_TMPDIR/${file_label}.json"

	# Single hyperfine run — comparison table + JSON
	# --prepare cleans all output files before each run to avoid stale data
	hyperfine \
		--warmup 2 \
		--min-runs 5 \
		--prepare "rm -f '$z7z_out' '$ref_st_out' '$ref_mt_out'" \
		--export-json "$result_json" \
		-n "z7z (auto)" "'$Z7Z' create '$z7z_out' '$data_file' 2>/dev/null" \
		-n "7zz -mx=5 -mmt=1" "7zz a -mx=5 -mmt=1 '$ref_st_out' '$data_file' > /dev/null" \
		-n "7zz -mx=5 -mmt=on" "7zz a -mx=5 -mmt=on '$ref_mt_out' '$data_file' > /dev/null"

	echo ""

	# Create fresh archives once for size comparison and interop testing
	# (hyperfine's --prepare may have deleted some during benchmarking)
	rm -f "$z7z_out" "$ref_st_out" "$ref_mt_out"
	"$Z7Z" create "$z7z_out" "$data_file" 2>/dev/null
	7zz a -mx=5 -mmt=1 "$ref_st_out" "$data_file" > /dev/null 2>&1
	7zz a -mx=5 -mmt=on "$ref_mt_out" "$data_file" > /dev/null 2>&1

	# Compression ratios
	echo -e "  ${BOLD}Compression ratios:${RESET}"
	for pair in "z7z (auto):$z7z_out" "7zz -mx=5 -mmt=1:$ref_st_out" "7zz -mx=5 -mmt=on:$ref_mt_out"; do
		local alabel="${pair%%:*}"
		local afile="${pair#*:}"
		if [ -f "$afile" ]; then
			local asize
			asize=$(wc -c < "$afile" | tr -d ' ')
			local aratio
			aratio=$(awk "BEGIN { printf \"%.1f\", ($asize / $original_size) * 100 }")
			echo -e "    ${CYAN}$alabel${RESET}: $asize bytes (${aratio}%)"
		fi
	done
	echo ""

	# Interop: 7zz validates z7z output
	echo -n "  Interop (7zz validates z7z archive): "
	if 7zz t "$z7z_out" > /dev/null 2>&1; then
		echo -e "${GREEN}OK${RESET}"
	else
		echo -e "${RED}FAILED${RESET}"
	fi
	echo ""

	# Log results and compare against previous
	log_results "$file_label" "$result_json" "$z7z_out" "$ref_st_out" "$ref_mt_out" "$original_size"
}

# ============================================================================
# Run Benchmarks
# ============================================================================

run_benchmark_group "$TEXT_1M" "text_1m"
run_benchmark_group "$TEXT_4M" "text_4m"
run_benchmark_group "$BIN_1M" "binary_1m"

# ============================================================================
# Summary
# ============================================================================

echo ""
echo -e "${BOLD}Results logged to:${RESET} $LOG_FILE"
echo -e "${BOLD}Done.${RESET}"
