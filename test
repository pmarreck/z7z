#!/usr/bin/env bash
set -euo pipefail

# z7z test runner — runs all test suites
# Exit code = number of failed suites (0 = all pass)

FAILURES=0

echo "=== Unit tests (Zig) ==="
if nix develop -c zig build test 2>&1; then
	echo "PASS: unit tests"
else
	echo "FAIL: unit tests"
	((FAILURES++))
fi

echo ""
echo "=== CLI integration tests ==="
if nix develop -c ./test-cli 2>&1; then
	echo "PASS: CLI tests"
else
	echo "FAIL: CLI tests"
	((FAILURES++))
fi

if [ "$FAILURES" -gt 0 ]; then
	echo ""
	echo "FAILED: $FAILURES suite(s)"
	exit "$FAILURES"
fi

echo ""
echo "ALL TESTS PASSED"
