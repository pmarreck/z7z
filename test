#!/usr/bin/env bash
set -euo pipefail

# z7z test runner — runs all test suites
# Exit code = number of failed suites (0 = all pass)

FAILURES=0

echo "=== Unit tests (Zig) ==="
if nix develop -c zig build test 2>&1; then
	echo "PASS: unit tests"
else
	echo "FAIL: unit tests"
	((FAILURES++))
fi

# Integration tests will be added here later
# echo "=== Integration tests (CLI) ==="
# if bash tests/integration/run.sh; then ...

if [ "$FAILURES" -gt 0 ]; then
	echo ""
	echo "FAILED: $FAILURES suite(s)"
	exit "$FAILURES"
fi

echo ""
echo "ALL TESTS PASSED"
