#!/usr/bin/env bash
# CLI integration tests for z7z.
# Run from project root: nix develop -c ./test-cli

set -euo pipefail

Z7Z="./zig-out/bin/z7z"
PASS=0
FAIL=0
TMPDIR=""

cleanup() {
	[ -n "$TMPDIR" ] && rm -rf "$TMPDIR"
}
trap cleanup EXIT

fail() {
	echo "  FAIL: $1"
	FAIL=$((FAIL + 1))
}

pass() {
	echo "  PASS: $1"
	PASS=$((PASS + 1))
}

assert_file_exists() {
	if [ -f "$2" ]; then pass "$1"; else fail "$1"; fi
}

assert_files_equal() {
	if diff -q "$2" "$3" > /dev/null 2>&1; then pass "$1"; else fail "$1"; fi
}

assert_contains() {
	if echo "$2" | grep -q "$3"; then pass "$1"; else fail "$1 (expected '$3')"; fi
}

assert_cmd_fails() {
	if "$@" > /dev/null 2>&1; then fail "$1"; else pass "$1"; fi
}

assert_symlink_target() {
	# $1 = test name, $2 = symlink path, $3 = expected target
	if [ -L "$2" ]; then
		local actual
		actual=$(readlink "$2")
		if [ "$actual" = "$3" ]; then pass "$1"; else fail "$1 (got '$actual', expected '$3')"; fi
	else
		fail "$1 (not a symlink)"
	fi
}

assert_is_symlink() {
	if [ -L "$2" ]; then pass "$1"; else fail "$1 (not a symlink)"; fi
}

# Cross-platform stat helpers (GNU coreutils in nix first, then BSD fallback)
get_mtime() {
	stat -c "%Y" "$1" 2>/dev/null || stat -f "%m" "$1" 2>/dev/null
}

get_perms() {
	stat -c "%a" "$1" 2>/dev/null || stat -f "%Lp" "$1" 2>/dev/null
}

# Build first
echo "Building z7z..."
zig build
echo ""

TMPDIR=$(mktemp -d)

# ============================================================================
# Test: create single file
# ============================================================================
echo "--- create + list + extract single file ---"

echo -n "Hello from CLI test!" > "$TMPDIR/hello.txt"
$Z7Z create "$TMPDIR/single.7z" "$TMPDIR/hello.txt"

assert_file_exists "create single file" "$TMPDIR/single.7z"

LIST_OUT=$($Z7Z list "$TMPDIR/single.7z")
assert_contains "list shows file count" "$LIST_OUT" "Files: 1"
assert_contains "list shows filename" "$LIST_OUT" "hello.txt"
assert_contains "list shows size 20" "$LIST_OUT" "20"

mkdir -p "$TMPDIR/out_single"
$Z7Z extract "$TMPDIR/single.7z" "$TMPDIR/out_single"
assert_file_exists "extract produces file" "$TMPDIR/out_single/hello.txt"
assert_files_equal "extract content matches" "$TMPDIR/hello.txt" "$TMPDIR/out_single/hello.txt"

# ============================================================================
# Test: create multi-file
# ============================================================================
echo ""
echo "--- create + list + extract multi-file ---"

echo -n "Alpha" > "$TMPDIR/a.txt"
echo -n "Beta" > "$TMPDIR/b.txt"
printf '\xDE\xAD\xBE\xEF' > "$TMPDIR/c.bin"
$Z7Z create "$TMPDIR/multi.7z" "$TMPDIR/a.txt" "$TMPDIR/b.txt" "$TMPDIR/c.bin"

LIST_OUT=$($Z7Z list "$TMPDIR/multi.7z")
assert_contains "multi list shows 3 files" "$LIST_OUT" "Files: 3"
assert_contains "multi list shows a.txt" "$LIST_OUT" "a.txt"
assert_contains "multi list shows b.txt" "$LIST_OUT" "b.txt"
assert_contains "multi list shows c.bin" "$LIST_OUT" "c.bin"

mkdir -p "$TMPDIR/out_multi"
$Z7Z extract "$TMPDIR/multi.7z" "$TMPDIR/out_multi"
assert_files_equal "multi extract a.txt" "$TMPDIR/a.txt" "$TMPDIR/out_multi/a.txt"
assert_files_equal "multi extract b.txt" "$TMPDIR/b.txt" "$TMPDIR/out_multi/b.txt"
assert_files_equal "multi extract c.bin" "$TMPDIR/c.bin" "$TMPDIR/out_multi/c.bin"

# ============================================================================
# Test: 7zz validates z7z output
# ============================================================================
echo ""
echo "--- 7zz oracle validation ---"

if command -v 7zz &>/dev/null; then
	ORACLE_OUT=$(7zz t "$TMPDIR/single.7z" 2>&1)
	assert_contains "7zz single: Everything is Ok" "$ORACLE_OUT" "Everything is Ok"

	ORACLE_OUT=$(7zz t "$TMPDIR/multi.7z" 2>&1)
	assert_contains "7zz multi: Everything is Ok" "$ORACLE_OUT" "Everything is Ok"

	# Extract with 7zz and compare
	mkdir -p "$TMPDIR/out_7zz"
	7zz x -y -o"$TMPDIR/out_7zz" "$TMPDIR/single.7z" > /dev/null
	assert_files_equal "7zz extraction matches" "$TMPDIR/hello.txt" "$TMPDIR/out_7zz/hello.txt"
else
	echo "  SKIP: 7zz not found"
fi

# ============================================================================
# Test: z7z reads 7zz-created archive
# ============================================================================
echo ""
echo "--- z7z reads 7zz-created archive ---"

if command -v 7zz &>/dev/null; then
	echo -n "Oracle content" > "$TMPDIR/oracle.txt"
	7zz a -m0=Copy "$TMPDIR/oracle.7z" "$TMPDIR/oracle.txt" > /dev/null

	LIST_OUT=$($Z7Z list "$TMPDIR/oracle.7z")
	assert_contains "z7z lists 7zz archive" "$LIST_OUT" "Files: 1"

	mkdir -p "$TMPDIR/out_oracle"
	$Z7Z extract "$TMPDIR/oracle.7z" "$TMPDIR/out_oracle"
	assert_files_equal "z7z extracts 7zz archive" "$TMPDIR/oracle.txt" "$TMPDIR/out_oracle/oracle.txt"
else
	echo "  SKIP: 7zz not found"
fi

# ============================================================================
# Test: error handling
# ============================================================================
echo ""
echo "--- error handling ---"

echo "not a 7z archive" > "$TMPDIR/bad.7z"
if $Z7Z list "$TMPDIR/bad.7z" > /dev/null 2>&1; then
	fail "should reject bad archive"
else
	pass "rejects bad archive"
fi

if $Z7Z list "$TMPDIR/nonexistent.7z" > /dev/null 2>&1; then
	fail "should fail on missing file"
else
	pass "fails on missing file"
fi

if $Z7Z > /dev/null 2>&1; then
	fail "should fail with no args"
else
	pass "fails with no args"
fi

# ============================================================================
# Test: --help, --about, --verbose flags
# ============================================================================
echo ""
echo "--- CLI flags: help, about, verbose ---"

HELP_OUT=$($Z7Z --help 2>&1)
assert_contains "help: shows usage" "$HELP_OUT" "Usage:"
assert_contains "help: shows commands" "$HELP_OUT" "Commands:"
assert_contains "help: shows options" "$HELP_OUT" "verbose"

# --help should exit 0
if $Z7Z --help > /dev/null 2>&1; then
	pass "help: exits 0"
else
	fail "help: exits 0"
fi

# -h should also work
if $Z7Z -h > /dev/null 2>&1; then
	pass "help: -h shorthand works"
else
	fail "help: -h shorthand works"
fi

ABOUT_OUT=$($Z7Z --about 2>&1)
assert_contains "about: shows version" "$ABOUT_OUT" "z7z"
assert_contains "about: shows platform" "$ABOUT_OUT" "cleanroom"

# --version should also work
VERSION_OUT=$($Z7Z --version 2>&1)
assert_contains "version: shows version" "$VERSION_OUT" "z7z"

# --verbose: extract should show file names
echo -n "Verbose test" > "$TMPDIR/verb.txt"
$Z7Z create "$TMPDIR/verb.7z" "$TMPDIR/verb.txt" > /dev/null
mkdir -p "$TMPDIR/out_verb"
VERB_OUT=$($Z7Z extract -v "$TMPDIR/verb.7z" "$TMPDIR/out_verb" 2>&1)
assert_contains "verbose: extract shows filenames" "$VERB_OUT" "verb.txt"

# Without --verbose: extract should NOT show filenames
mkdir -p "$TMPDIR/out_quiet"
QUIET_OUT=$($Z7Z extract "$TMPDIR/verb.7z" "$TMPDIR/out_quiet" 2>&1)
if echo "$QUIET_OUT" | grep -q "verb.txt"; then
	fail "quiet: extract hides filenames"
else
	pass "quiet: extract hides filenames"
fi

# ============================================================================
# Test: create from directory
# ============================================================================
echo ""
echo "--- create + list + extract directory ---"

mkdir -p "$TMPDIR/mydir/sub"
echo -n "Top-level file" > "$TMPDIR/mydir/top.txt"
echo -n "Nested file" > "$TMPDIR/mydir/sub/nested.txt"

$Z7Z create "$TMPDIR/dir.7z" "$TMPDIR/mydir"

assert_file_exists "create from directory" "$TMPDIR/dir.7z"

LIST_OUT=$($Z7Z list "$TMPDIR/dir.7z")
assert_contains "dir list shows mydir/" "$LIST_OUT" "mydir/"
assert_contains "dir list shows top.txt" "$LIST_OUT" "mydir/top.txt"
assert_contains "dir list shows sub/" "$LIST_OUT" "mydir/sub/"
assert_contains "dir list shows nested.txt" "$LIST_OUT" "mydir/sub/nested.txt"

mkdir -p "$TMPDIR/out_dir"
$Z7Z extract "$TMPDIR/dir.7z" "$TMPDIR/out_dir"
assert_file_exists "extract creates nested file" "$TMPDIR/out_dir/mydir/top.txt"
assert_file_exists "extract creates deeply nested file" "$TMPDIR/out_dir/mydir/sub/nested.txt"
assert_files_equal "dir extract top.txt" "$TMPDIR/mydir/top.txt" "$TMPDIR/out_dir/mydir/top.txt"
assert_files_equal "dir extract nested.txt" "$TMPDIR/mydir/sub/nested.txt" "$TMPDIR/out_dir/mydir/sub/nested.txt"

# Verify the sub/ directory actually exists
if [ -d "$TMPDIR/out_dir/mydir/sub" ]; then
	pass "extract creates subdirectory"
else
	fail "extract creates subdirectory"
fi

# ============================================================================
# Test: directory with trailing slash
# ============================================================================
echo ""
echo "--- directory with trailing slash ---"

$Z7Z create "$TMPDIR/dir_slash.7z" "$TMPDIR/mydir/"
assert_file_exists "create with trailing slash" "$TMPDIR/dir_slash.7z"

LIST_OUT=$($Z7Z list "$TMPDIR/dir_slash.7z")
assert_contains "trailing slash: shows mydir/" "$LIST_OUT" "mydir/"
assert_contains "trailing slash: shows top.txt" "$LIST_OUT" "mydir/top.txt"

# ============================================================================
# Test: mixed files and directories
# ============================================================================
echo ""
echo "--- mixed files and directories ---"

echo -n "Standalone" > "$TMPDIR/standalone.txt"
$Z7Z create "$TMPDIR/mixed.7z" "$TMPDIR/standalone.txt" "$TMPDIR/mydir"

LIST_OUT=$($Z7Z list "$TMPDIR/mixed.7z")
assert_contains "mixed: shows standalone" "$LIST_OUT" "standalone.txt"
assert_contains "mixed: shows mydir/" "$LIST_OUT" "mydir/"
assert_contains "mixed: shows nested" "$LIST_OUT" "mydir/sub/nested.txt"

mkdir -p "$TMPDIR/out_mixed"
$Z7Z extract "$TMPDIR/mixed.7z" "$TMPDIR/out_mixed"
assert_files_equal "mixed extract standalone" "$TMPDIR/standalone.txt" "$TMPDIR/out_mixed/standalone.txt"
assert_files_equal "mixed extract nested" "$TMPDIR/mydir/sub/nested.txt" "$TMPDIR/out_mixed/mydir/sub/nested.txt"

# ============================================================================
# Test: 7zz validates z7z directory archive
# ============================================================================
echo ""
echo "--- 7zz directory interop ---"

if command -v 7zz &>/dev/null; then
	ORACLE_OUT=$(7zz t "$TMPDIR/dir.7z" 2>&1)
	assert_contains "7zz dir: Everything is Ok" "$ORACLE_OUT" "Everything is Ok"

	# Extract with 7zz and verify
	mkdir -p "$TMPDIR/out_dir_7zz"
	7zz x -y -o"$TMPDIR/out_dir_7zz" "$TMPDIR/dir.7z" > /dev/null
	assert_files_equal "7zz dir extract top.txt" "$TMPDIR/mydir/top.txt" "$TMPDIR/out_dir_7zz/mydir/top.txt"
	assert_files_equal "7zz dir extract nested.txt" "$TMPDIR/mydir/sub/nested.txt" "$TMPDIR/out_dir_7zz/mydir/sub/nested.txt"

	# z7z reads 7zz-created directory archive
	mkdir -p "$TMPDIR/oracle_dir/sub"
	echo -n "Oracle top" > "$TMPDIR/oracle_dir/top.txt"
	echo -n "Oracle nested" > "$TMPDIR/oracle_dir/sub/deep.txt"
	7zz a "$TMPDIR/oracle_dir.7z" "$TMPDIR/oracle_dir" > /dev/null

	mkdir -p "$TMPDIR/out_oracle_dir"
	$Z7Z extract "$TMPDIR/oracle_dir.7z" "$TMPDIR/out_oracle_dir"
	# 7zz stores full path, so we need to find where it extracted
	if [ -f "$TMPDIR/out_oracle_dir/oracle_dir/top.txt" ]; then
		assert_files_equal "z7z extracts 7zz dir: top.txt" "$TMPDIR/oracle_dir/top.txt" "$TMPDIR/out_oracle_dir/oracle_dir/top.txt"
		assert_files_equal "z7z extracts 7zz dir: deep.txt" "$TMPDIR/oracle_dir/sub/deep.txt" "$TMPDIR/out_oracle_dir/oracle_dir/sub/deep.txt"
	else
		# 7zz might store with a different prefix — find the file
		FOUND=$(find "$TMPDIR/out_oracle_dir" -name "top.txt" 2>/dev/null | head -1)
		if [ -n "$FOUND" ]; then
			pass "z7z extracts 7zz dir: top.txt (found at $FOUND)"
			pass "z7z extracts 7zz dir: deep.txt (skipped — different prefix)"
		else
			fail "z7z extracts 7zz dir: top.txt (not found)"
			fail "z7z extracts 7zz dir: deep.txt (not found)"
		fi
	fi
else
	echo "  SKIP: 7zz not found"
fi

# ============================================================================
# Test: multi-folder (non-solid) archive extraction
# ============================================================================
echo ""
echo "--- multi-folder (non-solid) archive interop ---"

if command -v 7zz &>/dev/null; then
	# Create distinct files for a non-solid archive (each file gets its own folder)
	echo -n "Folder-one content here" > "$TMPDIR/mf_alpha.txt"
	echo -n "Folder-two different data" > "$TMPDIR/mf_beta.txt"
	echo -n "Third folder stuff!!!" > "$TMPDIR/mf_gamma.txt"

	# -ms=off disables solid mode: each file gets its own folder/block
	7zz a -ms=off "$TMPDIR/nonsolid.7z" "$TMPDIR/mf_alpha.txt" "$TMPDIR/mf_beta.txt" "$TMPDIR/mf_gamma.txt" > /dev/null

	# z7z must extract all files from all folders
	mkdir -p "$TMPDIR/out_nonsolid"
	$Z7Z extract "$TMPDIR/nonsolid.7z" "$TMPDIR/out_nonsolid"
	assert_files_equal "nonsolid: alpha.txt" "$TMPDIR/mf_alpha.txt" "$TMPDIR/out_nonsolid/mf_alpha.txt"
	assert_files_equal "nonsolid: beta.txt" "$TMPDIR/mf_beta.txt" "$TMPDIR/out_nonsolid/mf_beta.txt"
	assert_files_equal "nonsolid: gamma.txt" "$TMPDIR/mf_gamma.txt" "$TMPDIR/out_nonsolid/mf_gamma.txt"

	# Also test: large enough data to trigger 7zz block splitting with solid mode ON
	# (7zz default block size is ~2GB for LZMA2, so we need -ms=1k to force small blocks)
	echo -n "Block-A data for first solid block" > "$TMPDIR/ms_a.txt"
	echo -n "Block-B data for second solid block" > "$TMPDIR/ms_b.txt"
	7zz a -ms=1k "$TMPDIR/multiblock.7z" "$TMPDIR/ms_a.txt" "$TMPDIR/ms_b.txt" > /dev/null

	mkdir -p "$TMPDIR/out_multiblock"
	$Z7Z extract "$TMPDIR/multiblock.7z" "$TMPDIR/out_multiblock"
	assert_files_equal "multiblock: ms_a.txt" "$TMPDIR/ms_a.txt" "$TMPDIR/out_multiblock/ms_a.txt"
	assert_files_equal "multiblock: ms_b.txt" "$TMPDIR/ms_b.txt" "$TMPDIR/out_multiblock/ms_b.txt"
else
	echo "  SKIP: 7zz not found"
fi

# ============================================================================
# Test: symlink roundtrip (create + extract)
# ============================================================================
echo ""
echo "--- symlink roundtrip ---"

mkdir -p "$TMPDIR/symdir"
echo -n "Symlink target content" > "$TMPDIR/symdir/target.txt"
ln -s target.txt "$TMPDIR/symdir/link.txt"

$Z7Z create "$TMPDIR/symlink.7z" "$TMPDIR/symdir"
assert_file_exists "symlink: archive created" "$TMPDIR/symlink.7z"

mkdir -p "$TMPDIR/out_sym"
$Z7Z extract "$TMPDIR/symlink.7z" "$TMPDIR/out_sym"
assert_symlink_target "symlink: link.txt target" "$TMPDIR/out_sym/symdir/link.txt" "target.txt"
assert_files_equal "symlink: target.txt content" "$TMPDIR/symdir/target.txt" "$TMPDIR/out_sym/symdir/target.txt"

# ============================================================================
# Test: symlink list display
# ============================================================================
echo ""
echo "--- symlink list display ---"

LIST_OUT=$($Z7Z list "$TMPDIR/symlink.7z")
assert_contains "symlink list: shows symlink marker" "$LIST_OUT" "<symlink>"
assert_contains "symlink list: shows target" "$LIST_OUT" "target.txt"

# ============================================================================
# Test: broken symlink (target doesn't exist)
# ============================================================================
echo ""
echo "--- broken symlink preservation ---"

mkdir -p "$TMPDIR/broken"
ln -s nonexistent_file "$TMPDIR/broken/dead_link"

$Z7Z create "$TMPDIR/broken.7z" "$TMPDIR/broken"
assert_file_exists "broken symlink: archive created" "$TMPDIR/broken.7z"

mkdir -p "$TMPDIR/out_broken"
$Z7Z extract "$TMPDIR/broken.7z" "$TMPDIR/out_broken"
assert_symlink_target "broken symlink: preserved" "$TMPDIR/out_broken/broken/dead_link" "nonexistent_file"

# ============================================================================
# Test: --dereference flag (follow symlinks)
# ============================================================================
echo ""
echo "--- --dereference flag ---"

mkdir -p "$TMPDIR/deref"
echo -n "Dereference content" > "$TMPDIR/deref/real.txt"
ln -s real.txt "$TMPDIR/deref/follow_me"

$Z7Z create --dereference "$TMPDIR/deref.7z" "$TMPDIR/deref"
assert_file_exists "dereference: archive created" "$TMPDIR/deref.7z"

mkdir -p "$TMPDIR/out_deref"
$Z7Z extract "$TMPDIR/deref.7z" "$TMPDIR/out_deref"
# With --dereference, the symlink should be stored as a regular file
if [ -L "$TMPDIR/out_deref/deref/follow_me" ]; then
	fail "dereference: should NOT be a symlink"
else
	if [ -f "$TMPDIR/out_deref/deref/follow_me" ]; then
		# Content should match the target file
		if diff -q "$TMPDIR/deref/real.txt" "$TMPDIR/out_deref/deref/follow_me" > /dev/null 2>&1; then
			pass "dereference: stored as regular file with correct content"
		else
			fail "dereference: content mismatch"
		fi
	else
		fail "dereference: file not found"
	fi
fi

# ============================================================================
# Test: 7zz interop (z7z → 7zz)
# ============================================================================
echo ""
echo "--- symlink 7zz interop ---"

if command -v 7zz &>/dev/null; then
	ORACLE_OUT=$(7zz t "$TMPDIR/symlink.7z" 2>&1)
	assert_contains "7zz symlink: Everything is Ok" "$ORACLE_OUT" "Everything is Ok"

	# 7zz interop (7zz → z7z): create archive with symlinks using 7zz -snl
	mkdir -p "$TMPDIR/7zz_sym"
	echo -n "7zz symlink test" > "$TMPDIR/7zz_sym/file.txt"
	ln -s file.txt "$TMPDIR/7zz_sym/link.txt"
	7zz a -snl "$TMPDIR/7zz_symlink.7z" "$TMPDIR/7zz_sym/" > /dev/null

	mkdir -p "$TMPDIR/out_7zz_sym"
	$Z7Z extract "$TMPDIR/7zz_symlink.7z" "$TMPDIR/out_7zz_sym"
	assert_symlink_target "7zz→z7z: symlink target" "$TMPDIR/out_7zz_sym/7zz_sym/link.txt" "file.txt"
else
	echo "  SKIP: 7zz not found"
fi

# ============================================================================
# Test: security — absolute symlink target rejected
# ============================================================================
echo ""
echo "--- symlink security ---"

# Create an archive manually with an absolute symlink target
# We use the FFI through z7z — create a dir with a symlink pointing to /etc/passwd
mkdir -p "$TMPDIR/evil"
ln -s /etc/passwd "$TMPDIR/evil/pwned"

$Z7Z create "$TMPDIR/evil.7z" "$TMPDIR/evil"
assert_file_exists "security: evil archive created" "$TMPDIR/evil.7z"

# Extraction should warn and skip the absolute symlink
# (extract may return non-zero when entries are skipped, so capture with || true)
EXTRACT_OUT=$($Z7Z extract "$TMPDIR/evil.7z" "$TMPDIR/out_evil" 2>&1 || true)
if [ -L "$TMPDIR/out_evil/evil/pwned" ]; then
	fail "security: absolute symlink should be rejected"
else
	assert_contains "security: warns about absolute target" "$EXTRACT_OUT" "absolute"
fi

# ============================================================================
# Test: metadata preservation — mtime roundtrip
# ============================================================================
echo ""
echo "--- metadata: mtime preservation ---"

mkdir -p "$TMPDIR/meta"
echo -n "Metadata test content" > "$TMPDIR/meta/timed.txt"
# Set a specific mtime: 2024-01-15 12:00:00 UTC
touch -t 202401151200.00 "$TMPDIR/meta/timed.txt"
ORIG_MTIME=$(get_mtime "$TMPDIR/meta/timed.txt")

$Z7Z create "$TMPDIR/meta.7z" "$TMPDIR/meta"
assert_file_exists "mtime: archive created" "$TMPDIR/meta.7z"

mkdir -p "$TMPDIR/out_meta"
$Z7Z extract "$TMPDIR/meta.7z" "$TMPDIR/out_meta"

RESTORED_MTIME=$(get_mtime "$TMPDIR/out_meta/meta/timed.txt")
if [ "$ORIG_MTIME" = "$RESTORED_MTIME" ]; then
	pass "mtime: file timestamp preserved"
else
	fail "mtime: file timestamp preserved (orig=$ORIG_MTIME, got=$RESTORED_MTIME)"
fi

# ============================================================================
# Test: metadata preservation — permissions roundtrip
# ============================================================================
echo ""
echo "--- metadata: permissions preservation ---"

mkdir -p "$TMPDIR/perms"
echo -n "Permission test" > "$TMPDIR/perms/secret.txt"
chmod 0640 "$TMPDIR/perms/secret.txt"
echo -n "Executable" > "$TMPDIR/perms/run.sh"
chmod 0755 "$TMPDIR/perms/run.sh"

$Z7Z create "$TMPDIR/perms.7z" "$TMPDIR/perms"
assert_file_exists "perms: archive created" "$TMPDIR/perms.7z"

mkdir -p "$TMPDIR/out_perms"
$Z7Z extract "$TMPDIR/perms.7z" "$TMPDIR/out_perms"

# Check permissions are restored (macOS stat -f vs Linux stat -c)
ORIG_MODE_SECRET=$(get_perms "$TMPDIR/perms/secret.txt")
RESTORED_MODE_SECRET=$(get_perms "$TMPDIR/out_perms/perms/secret.txt")
if [ "$ORIG_MODE_SECRET" = "$RESTORED_MODE_SECRET" ]; then
	pass "perms: 0640 file permissions preserved"
else
	fail "perms: 0640 file permissions preserved (orig=$ORIG_MODE_SECRET, got=$RESTORED_MODE_SECRET)"
fi

ORIG_MODE_EXEC=$(get_perms "$TMPDIR/perms/run.sh")
RESTORED_MODE_EXEC=$(get_perms "$TMPDIR/out_perms/perms/run.sh")
if [ "$ORIG_MODE_EXEC" = "$RESTORED_MODE_EXEC" ]; then
	pass "perms: 0755 executable permissions preserved"
else
	fail "perms: 0755 executable permissions preserved (orig=$ORIG_MODE_EXEC, got=$RESTORED_MODE_EXEC)"
fi

# ============================================================================
# Test: metadata preservation — directory mtime
# ============================================================================
echo ""
echo "--- metadata: directory mtime ---"

mkdir -p "$TMPDIR/dirmeta/sub"
echo -n "content" > "$TMPDIR/dirmeta/sub/file.txt"
# Set directory mtime to a specific time
touch -t 202306010900.00 "$TMPDIR/dirmeta/sub"

ORIG_DIR_MTIME=$(get_mtime "$TMPDIR/dirmeta/sub")

$Z7Z create "$TMPDIR/dirmeta.7z" "$TMPDIR/dirmeta"

mkdir -p "$TMPDIR/out_dirmeta"
$Z7Z extract "$TMPDIR/dirmeta.7z" "$TMPDIR/out_dirmeta"

RESTORED_DIR_MTIME=$(get_mtime "$TMPDIR/out_dirmeta/dirmeta/sub")
if [ "$ORIG_DIR_MTIME" = "$RESTORED_DIR_MTIME" ]; then
	pass "dirmeta: directory mtime preserved"
else
	fail "dirmeta: directory mtime preserved (orig=$ORIG_DIR_MTIME, got=$RESTORED_DIR_MTIME)"
fi

# ============================================================================
# Test: 7zz → z7z metadata interop
# ============================================================================
echo ""
echo "--- metadata: 7zz interop ---"

if command -v 7zz &>/dev/null; then
	mkdir -p "$TMPDIR/7zz_meta"
	echo -n "7zz metadata test" > "$TMPDIR/7zz_meta/stamp.txt"
	touch -t 202502010800.00 "$TMPDIR/7zz_meta/stamp.txt"
