	assert_file_exists "birthtime: archive created" "$TMPDIR/btime.7z"

	mkdir -p "$TMPDIR/out_btime"
	$Z7Z extract "$TMPDIR/btime.7z" "$TMPDIR/out_btime"

	RESTORED_BTIME=$(get_birthtime "$TMPDIR/out_btime/btime/born.txt")
	if [ "$ORIG_BTIME" = "$RESTORED_BTIME" ]; then
		pass "birthtime: file creation time preserved"
	else
		fail "birthtime: file creation time preserved (orig=$ORIG_BTIME, got=$RESTORED_BTIME)"
	fi
