#!/usr/bin/env bash
# C CLI/C ABI regressions over independent oracle fixtures. Does not build.
# Z7Z selects the binary; Z7Z_CODEC_REPORT optionally retains a JSON result.
# Z7Z_ORACLE optionally cross-checks good and damaged archive acceptance.
# Functions invoked through capture or EXIT are intentional callbacks.
# shellcheck disable=SC2329
set -u

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
Z7Z=${Z7Z:-"$ROOT/zig-out/bin/z7z"}
PASS=0
FAIL=0
SUPPORTED=0
UNSUPPORTED=0
OTHER=0
WORK=""
out=""
err=""
rc=0

pass() { PASS=$((PASS + 1)); }
fail() { printf 'FAIL: %s\n' "$*"; FAIL=$((FAIL + 1)); }
fatal() { printf 'FAIL: %s\n' "$*"; exit 1; }

for tool in jq sha256sum mktemp cp dd od head wc find timeout; do
	command -v "$tool" >/dev/null 2>&1 || fatal "missing dependency: $tool"
done
[[ -x "$Z7Z" ]] || fatal "binary is not executable: $Z7Z"
RAM_ROOT=${TMPDIR:-/dev/shm}
[[ -d "$RAM_ROOT" && -w "$RAM_ROOT" ]] || fatal "TMPDIR must name a writable RAM temp directory"
WORK=$(mktemp -d "$RAM_ROOT/z7z-codec-cli.XXXXXXXX") || fatal "cannot create isolated temp directory"
cleanup() {
	# Every file below this fresh directory was generated by this suite.
	case "$WORK" in "$RAM_ROOT"/z7z-codec-cli.*) rm -rf -- "$WORK" ;; esac
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

CAPTURE_SOURCE=${CAPTURE_BASH:-${HOME:-}/dotfiles/bin/src/capture.bash}
if [[ -r "$CAPTURE_SOURCE" ]]; then
	# Prefer Peter's RAM-only stdout/stderr/status capture when available.
	# shellcheck source=/dev/null
	source "$CAPTURE_SOURCE"
else
	# CI need not depend on a personal dotfiles checkout; these files are in RAM.
	capture() {
		"$@" >"$WORK/stdout" 2>"$WORK/stderr"
		rc=$?
		out=$(<"$WORK/stdout")
		err=$(<"$WORK/stderr")
	}
fi

capture cp -- "$Z7Z" "$WORK/z7z"
[[ $rc -eq 0 ]] || fatal "cannot snapshot binary"
BIN="$WORK/z7z"
capture sha256sum "$BIN"
[[ $rc -eq 0 ]] || fatal "cannot hash binary"
BINARY_HASH=${out%% *}
ORACLE_HASH=""
ORACLE_BIN=""
if [[ -n ${Z7Z_ORACLE:-} ]]; then
	[[ -x "$Z7Z_ORACLE" ]] || fatal "oracle is not executable"
	capture cp -- "$Z7Z_ORACLE" "$WORK/oracle"
	[[ $rc -eq 0 ]] || fatal "cannot snapshot oracle"
	ORACLE_BIN="$WORK/oracle"
	capture sha256sum "$ORACLE_BIN"
	[[ $rc -eq 0 ]] || fatal "cannot hash oracle"
	ORACLE_HASH=${out%% *}
fi
export LC_ALL=C
export Z7Z_LANG=en
export MUTE_DEBUG_STATUS=1

run_cli() {
	capture timeout --kill-after=5s 30s "$BIN" --no-progress "$@"
}

manifest_rows() {
	local family=$1 count=$2 manifest="$WORK/$1-manifest.json"
	jq -er --arg family "$family" --argjson count "$count" --arg oracle_hash "$ORACLE_HASH" '
		if $oracle_hash != "" and .oracle_sha256 != $oracle_hash then error("oracle hash differs from provenance") else . end
		| if (.cases | length) < $count then error("missing required fixture coverage") else . end
		| if ([.cases[].name] | unique | length) != (.cases | length) then error("duplicate fixture names") else . end
		| .cases[]
		| if (.name | test("^[a-zA-Z0-9_-]+$")) then . else error("unsafe fixture name") end
		| . as $c
		| (if $family == "filters" then [$c.name + "/oracle.7z", "plain.bin", $c.plain_sha256, $c.bytes]
		   elif $family == "deflate64" then [$c.name + ".7z", $c.name + ".plain", $c.plain_sha256, $c.plain_size]
		   else [$c.name + ".7z", $c.name + ".bin", $c.input_sha256, $c.size] end) as $v
		| ($c.filename // $v[1]) as $entry
		| if (($v[2] | type) == "string" and ($v[2] | test("^[a-f0-9]{64}$"))
		      and ($c.archive_sha256 | type) == "string" and ($c.archive_sha256 | test("^[a-f0-9]{64}$"))
		      and ($entry | type) == "string" and ($entry | test("^[a-zA-Z0-9_.-]+$")) and $entry != "." and $entry != ".."
		      and ($v[3] | type) == "number" and $v[3] > 0 and ($v[3] | floor) == $v[3])
		  then [$family, $c.name, $v[0], $entry, $v[2], ($v[3] | tostring), $c.archive_sha256] | @tsv
		  else error("invalid fixture hash or size") end
	' "$manifest"
}

: >"$WORK/cases.tsv"
: >"$WORK/results.ndjson"
: >"$WORK/manifests.ndjson"
for group_count in filters:22 deflate64:5 bzip2:3; do
	family=${group_count%:*}
	capture cp -- "$ROOT/src/fixtures/$family/provenance.json" "$WORK/$family-manifest.json"
	[[ $rc -eq 0 ]] || fatal "cannot snapshot $family manifest"
	capture sha256sum "$WORK/$family-manifest.json"
	[[ $rc -eq 0 ]] || fatal "cannot hash $family manifest"
	jq -nc --arg family "$family" --arg hash "${out%% *}" '{family:$family,sha256:$hash}' >>"$WORK/manifests.ndjson" || fatal "cannot record manifest hash"
	capture manifest_rows "$family" "${group_count#*:}"
	[[ $rc -eq 0 ]] || fatal "invalid $group_count manifest: $err"
	printf '%s\n' "$out" >>"$WORK/cases.tsv"
done
EXPECTED=$(wc -l <"$WORK/cases.tsv")

corrupt_payload() {
	local source=$1 dest=$2 family=$3 byte octal
	cp -- "$source" "$dest" || return 1
	byte=$(od -An -tu1 -j32 -N1 "$source") || return 1
	[[ -n "$byte" ]] || return 1
	# Reserved BTYPE=3 is invalid even in stored blocks with ignored padding.
	if [[ "$family" == deflate64 ]]; then byte=$((byte | 6)); else byte=$((byte ^ 1)); fi
	printf -v octal '%03o' "$byte"
	printf '%b' "\\$octal" | dd of="$dest" bs=1 seek=32 conv=notrunc status=none
}

truncate_archive() {
	head -c "$2" "$1" >"$3"
}

expect_rejection() {
	local label=$1
	if [[ $rc -eq 1 && -z "$out" && "$err" =~ (checksum\ mismatch|truncated\ input|structural\ error\ in\ archive) ]]; then
		pass
	else
		fail "$label rejection (exit=$rc; expected checksum/truncation/structure error)"
	fi
}

INDEX=0
while IFS=$'\t' read -r family name relative entry plain_hash plain_size archive_hash; do
	INDEX=$((INDEX + 1))
	label="$family/$name"
	archive="$ROOT/src/fixtures/$family/$relative"
	capture sha256sum "$archive"
	if [[ $rc -ne 0 || ${out%% *} != "$archive_hash" ]]; then
		fail "$label archive provenance hash"
		continue
	fi
	pass
	case_dir="$WORK/$INDEX $family-$name"
	capture mkdir -p -- "$case_dir"
	[[ $rc -eq 0 ]] || fatal "$label cannot create temp case"
	good="$case_dir/original archive.7z"
	capture cp -- "$archive" "$good"
	[[ $rc -eq 0 ]] || fatal "$label cannot copy fixture"
	capture sha256sum "$good"
	[[ $rc -eq 0 && ${out%% *} == "$archive_hash" ]] || fatal "$label fixture changed while snapshotting"
	if [[ -n "$ORACLE_BIN" ]]; then
		capture timeout --kill-after=5s 30s "$ORACLE_BIN" t "$good"
		if [[ $rc -eq 0 && -z "$err" && "$out" == *"Everything is Ok"* ]]; then pass; else fail "$label oracle good counterpart (exit=$rc)"; fi
	fi

	run_cli test "$good"
	test_rc=$rc
	classification=other_failure
	if [[ $rc -eq 0 && -z "$out" && "$err" == *"Everything is Ok"* ]]; then
		classification=supported
		SUPPORTED=$((SUPPORTED + 1))
		pass
	elif [[ $rc -eq 1 && "$err" == *"unsupported feature"* ]]; then
		classification=unsupported
		UNSUPPORTED=$((UNSUPPORTED + 1))
		fail "$label test unsupported"
	else
		OTHER=$((OTHER + 1))
		fail "$label test unexpected result (exit=$rc)"
	fi

	run_cli list "$good"
	list_rc=$rc
	if [[ $rc -eq 0 && -z "$err" && ${out%%$'\n'*} == 'Files: 1' && "$out" == *"$entry"* ]]; then pass; else fail "$label list (exit=$rc)"; fi

	extracted="$case_dir/extracted contents"
	run_cli extract "$good" "$extracted"
	extract_rc=$rc
	actual_hash=""
	if [[ $rc -eq 0 && -f "$extracted/$entry" && ! -L "$extracted/$entry" ]]; then
		pass
		capture find "$extracted" -mindepth 1 -print
		if [[ $rc -eq 0 && "$out" == "$extracted/$entry" ]]; then pass; else fail "$label exact extraction inventory"; fi
		capture sha256sum "$extracted/$entry"
		actual_hash=${out%% *}
		if [[ $rc -eq 0 && "$actual_hash" == "$plain_hash" ]]; then pass; else fail "$label extracted SHA-256"; fi
		capture wc -c <"$extracted/$entry"
		if [[ $rc -eq 0 && "$out" -eq "$plain_size" ]]; then pass; else fail "$label extracted size"; fi
	else
		fail "$label extract (exit=$rc)"
	fi

	corrupt="$case_dir/corrupt payload.7z"
	capture corrupt_payload "$good" "$corrupt" "$family"
	[[ $rc -eq 0 ]] || fatal "$label cannot construct payload corruption"
	truncated="$case_dir/truncated archive.7z"
	capture wc -c <"$good"
	[[ $rc -eq 0 && "$out" -gt 33 ]] || fatal "$label invalid archive length"
	# Archives are binary: redirect into RAM, never capture bytes in a Bash string.
	capture truncate_archive "$good" "$((out - 1))" "$truncated"
	[[ $rc -eq 0 ]] || fatal "$label cannot truncate fixture"
	for damaged in "$corrupt" "$truncated"; do
		if [[ -n "$ORACLE_BIN" ]]; then
			capture timeout --kill-after=5s 30s "$ORACLE_BIN" t "$damaged"
			if [[ $rc -eq 2 && "$err" =~ (CRC\ Failed|Data\ Error|Headers\ Error|Unexpected\ end\ of\ archive) ]]; then pass; else fail "$label oracle damage rejection (exit=$rc)"; fi
		fi
		run_cli test "$damaged"
		expect_rejection "$label $(basename -- "$damaged") test"
		run_cli extract "$damaged" "$case_dir/rejected output"
		expect_rejection "$label $(basename -- "$damaged") extract"
		if [[ -d "$case_dir/rejected output" ]]; then
			capture find "$case_dir/rejected output" -mindepth 1 -print
			if [[ $rc -eq 0 && -z "$out" ]]; then pass; else fail "$label rejected extraction wrote entries"; fi
		else
			pass
		fi
	done

	jq -nc --arg fixture "$label" --arg classification "$classification" --arg expected_sha256 "$plain_hash" \
		--arg actual_sha256 "$actual_hash" --argjson test_exit "$test_rc" --argjson list_exit "$list_rc" --argjson extract_exit "$extract_rc" \
		'{fixture:$fixture,classification:$classification,test_exit:$test_exit,list_exit:$list_exit,extract_exit:$extract_exit,expected_sha256:$expected_sha256,actual_sha256:$actual_sha256}' \
		>>"$WORK/results.ndjson" || fatal "cannot record $label result"
done <"$WORK/cases.tsv"

# shellcheck disable=SC2016
capture jq -es --argjson expected "$EXPECTED" 'length == $expected and (map(.fixture) | unique | length) == $expected' "$WORK/results.ndjson"
if [[ $rc -eq 0 ]]; then pass; else fail "expected all $EXPECTED distinct fixture classifications"; fi
if [[ $SUPPORTED -eq $EXPECTED && $UNSUPPORTED -eq 0 && $OTHER -eq 0 ]]; then pass; else fail "complete supported set (supported=$SUPPORTED unsupported=$UNSUPPORTED other=$OTHER)"; fi

if [[ -n ${Z7Z_CODEC_REPORT:-} ]]; then
	jq -s --slurpfile manifests "$WORK/manifests.ndjson" --arg binary_sha256 "$BINARY_HASH" --arg oracle_sha256 "$ORACLE_HASH" --argjson passed "$PASS" --argjson failed "$FAIL" \
		'{binary_sha256:$binary_sha256,oracle_sha256:$oracle_sha256,manifests:$manifests,passed:$passed,failed:$failed,supported:[.[]|select(.classification=="supported")|.fixture],unsupported:[.[]|select(.classification=="unsupported")|.fixture],other_failures:[.[]|select(.classification=="other_failure")|.fixture],cases:.}' \
		"$WORK/results.ndjson" >"$Z7Z_CODEC_REPORT" || fail "cannot write requested JSON report"
fi
printf 'Codec fixtures: %d passed, %d failed; supported=%d unsupported=%d other=%d\n' "$PASS" "$FAIL" "$SUPPORTED" "$UNSUPPORTED" "$OTHER"
if (( FAIL > 255 )); then exit 255; fi
exit "$FAIL"
