#!/usr/bin/env bash
set -euo pipefail

# z7z build script
# Usage: ./build [--test] [--debug]

MODE="ReleaseFast"
EXTRA_ARGS=()

for arg in "$@"; do
	case "$arg" in
		--test)
			EXTRA_ARGS+=("-Doptimize=ReleaseFast")
			exec nix develop -c zig build test "${EXTRA_ARGS[@]}"
			;;
		--debug)
			MODE="Debug"
			;;
		*)
			echo "Unknown argument: $arg" >&2
			echo "Usage: ./build [--test] [--debug]" >&2
			exit 1
			;;
	esac
done

exec nix develop -c zig build "-Doptimize=${MODE}" "${EXTRA_ARGS[@]}"
