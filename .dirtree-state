# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=2

close=[
	.direnv
]

annotate=[
	.mechatron-prime/targets = Exact-commit Mechatron targets for native tests and five release builds
	README.md = Project overview, Mechatron badge, features, build commands, and usage
	bm = Hyperfine benchmark suite for compression and z7z verify microbenchmarks over deterministic datasets
	build_all = Five-target ReleaseFast cross-build entry point
	cli/main.c = C CLI dogfooding the FFI with cross-platform metadata and extraction adapters
	flake.nix = Nix package/check/devshell with five explicit Mechatron cross-build outputs
	include/z7z.h = Public C FFI declarations and error codes for z7z
	src/archive.zig = Archive create/read plus slice and range-backed streaming verification orchestration
	src/codec.zig = 7z codec dispatch with bounded streaming LZMA/LZMA2, x86 BCJ, and BCJ2 pipelines
	src/ffi.zig = C ABI wrapper around z7z core, dogfooded by CLI and FFI tests
	src/interop_test.zig = 7zz oracle interop for codecs, filters, encryption, and corruption parity
	src/metadata.zig = 7z header parser with range-backed encoded-header decoding
	src/range_source.zig = Bounded short-read random-access source with optional zero-copy borrowing
	tests/benchmark/benchmark.log = Tracked hyperfine benchmark history for compression and verify timings.
	tools/verify_bench.zig = Verify microbenchmark harness that repeatedly calls Zig archive.verify() on one loaded archive
]
